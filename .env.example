# Railway Postgres connection string (use the Postgres service's DATABASE_URL variable)
DATABASE_URL="postgresql://user:password@host:5432/railway"

# Seedance 2.5 video-edit API. Server-side only — never expose to the browser.
# SEEDANCE_PROVIDER: "modelark" (BytePlus ModelArk, default) or "muapi" (muapi.ai gateway).
SEEDANCE_PROVIDER="modelark"
# ModelArk API key: console → API keys (the value used as ARK_API_KEY).
SEEDANCE_API_KEY=""
# Optional overrides. Defaults: ModelArk https://ark.ap-southeast.bytepluses.com/api/v3 and model
# dreamina-seedance-2-5-260628; Muapi https://api.muapi.ai/api/v1.
# SEEDANCE_BASE_URL=""
# SEEDANCE_MODEL=""
# Public URL of this app. The AI provider downloads uploaded selfies from {APP_URL}/api/uploads/{id},
# so it must be reachable from the internet (use a tunnel such as ngrok in local dev).
APP_URL="https://your-app.up.railway.app"
# Public https URL of the template video for "3 Guys Dancing" (applied by the seed on deploy).
THREE_GUYS_TEMPLATE_VIDEO_URL=""
# Free generations a guest gets before they must log in.
GUEST_FREE_GENERATIONS=1
# Optional cap on pooled DB connections.
# DATABASE_POOL_MAX=10

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google OAuth client (console.cloud.google.com → APIs & Services → Credentials)
# Authorized redirect URI: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Sign in with Apple (developer.apple.com). AUTH_APPLE_ID is the Services ID;
# generate AUTH_APPLE_SECRET with scripts/apple-client-secret.mjs (expires after 6 months).
# Return URL: {APP_URL}/api/auth/callback/apple
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""
