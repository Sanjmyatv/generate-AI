# Railway Postgres connection string (use the Postgres service's DATABASE_URL variable)
DATABASE_URL="postgresql://user:password@host:5432/railway"

# Seedance 2.5 video-edit API. Server-side only — never expose to the browser.
# SEEDANCE_PROVIDER: "modelark" (BytePlus ModelArk, default) or "muapi" (muapi.ai gateway).
SEEDANCE_PROVIDER="modelark"
# ModelArk API key: console → API keys (the value used as ARK_API_KEY).
SEEDANCE_API_KEY=""
# Optional overrides. Defaults: ModelArk https://ark.ap-southeast.bytepluses.com/api/v3 and model
# dreamina-seedance-2-5-260628; Muapi https://api.muapi.ai/api/v1.
# SEEDANCE_BASE_URL=""
# SEEDANCE_MODEL=""
# Public URL of this app. The AI provider downloads uploaded selfies from {APP_URL}/api/uploads/{id},
# so it must be reachable from the internet (use a tunnel such as ngrok in local dev).
APP_URL="https://your-app.up.railway.app"
# Public https URL of the template video for "3 Guys Dancing" (applied by the seed on deploy).
THREE_GUYS_TEMPLATE_VIDEO_URL=""
# Higgsfield Genjutsu motion transfer (console.higgsfield.ai → API keys). Format KEY_ID:KEY_SECRET.
# Server-side only. Billed per second of source video, so keep template videos short.
HIGGSFIELD_CREDENTIALS=""
# Public https URL (4–30 s) of the source video for the "Character Swap" template (applied by the seed).
GENJUTSU_TEMPLATE_VIDEO_URL=""
# QPay merchant API (credits are bought with QPay). Credentials come from QPay; keep them in the
# server's environment only. QPAY_BASE_URL is optional (defaults to the production API).
QPAY_USERNAME=""
QPAY_PASSWORD=""
QPAY_INVOICE_CODE=""
# QPAY_BASE_URL="https://merchant.qpay.mn/v2"
# Free generations a guest gets before they must log in. 0 (the default) means log in first:
# new Google accounts start with 1,000 free credits instead.
GUEST_FREE_GENERATIONS=0
# Optional cap on pooled DB connections.
# DATABASE_POOL_MAX=10

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# People can sign in with Google or email + password. Set to 0 to turn email + password off.
# ENABLE_EMAIL_LOGIN=0

# Google OAuth client (console.cloud.google.com → APIs & Services → Credentials)
# Authorized redirect URI: {APP_URL}/api/auth/callback/google
#   production: https://www.zyro.one/api/auth/callback/google   (APP_URL=https://www.zyro.one)
#   local dev:  http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Google Gemini, used by the admin panel to analyze template videos (aistudio.google.com → Get API key). Server-side only.
GEMINI_API_KEY=""
# Model that watches template videos in the admin panel ("Analyze with Gemini"). Default: gemini-3.6-flash
# GEMINI_ANALYSIS_MODEL=""
# Email for password reset links, sent through Resend (resend.com). Verify your domain there first,
# then use an address on it as the sender. Without these, reset emails are not sent.
RESEND_API_KEY=""
EMAIL_FROM="zyro.ai <no-reply@zyro.one>"
# Exchange rate (MNT per USD) the admin panel uses to turn provider costs into ₮ for margin math.
USD_MNT_RATE=3500
