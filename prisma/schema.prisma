generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OutputType {
  IMAGE
  VIDEO
}

enum PhotoRequirement {
  FACE
  FULL_BODY
}

enum GenerationStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum LedgerReason {
  PURCHASE
  BONUS
  GENERATION
  REFUND
  ADJUSTMENT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id        String   @id @default(cuid())
  /** Public, immutable, human-readable ID (e.g. USR_829381). */
  publicId  String   @unique
  name      String?
  email     String?  @unique
  googleId  String?  @unique
  appleId   String?  @unique
  /// scrypt hash for email + password sign-in; null for Google-only accounts.
  passwordHash String?
  /// Can open /admin. Set by hand in the database, never from the app.
  isAdmin   Boolean  @default(false)
  /** Cached balance. The CreditLedger is the source of truth. */
  credits   Decimal  @default(0) @db.Decimal(10, 2)
  /// When the free signup credits were granted; null until then, so they are only given once.
  signupBonusAt DateTime?
  createdAt DateTime @default(now())

  generations Generation[]
  ledger      CreditLedger[]
  payments    Payment[]
  passwordResets PasswordResetToken[]
}

/// A one-time "forgot password" link. Only a hash of the token is stored, so a database leak
/// cannot be used to reset anyone's password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Category {
  id        String     @id
  name      String
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  templates Template[]
}

model Template {
  id                 String           @id
  name               String
  description        String
  /// Mongolian name and description, shown to visitors browsing in Mongolian; empty falls back to the English ones.
  nameMn             String?
  descriptionMn      String?
  previewUrl         String?
  categoryId         String
  category           Category         @relation(fields: [categoryId], references: [id])
  type               OutputType
  /// Credits for one generation. For video this is the 480p (default) price.
  creditCost         Decimal          @db.Decimal(10, 2)
  /// Credits at 720p HD; null means the template is offered at 480p only.
  creditCostHd       Decimal?         @db.Decimal(10, 2)
  /// Image templates: credits for a 2K and a 4K render (creditCost is the 1K price). Empty = tier not offered;
  /// with neither set the image has one price and renders at the size in its configuration.
  creditCost2k       Decimal?         @db.Decimal(10, 2)
  creditCost4k       Decimal?         @db.Decimal(10, 2)
  /// Length of the video this template produces, in seconds.
  durationSeconds    Int?
  aspectRatio        String           @default("3:4")
  requiredPhotoCount Int              @default(1)
  /// One label per required photo, in order (e.g. "Dancer on the left"). Empty = "Photo N".
  photoLabels        String[]         @default([])
  photoRequirement   PhotoRequirement @default(FACE)
  /// AI model / provider configuration (opaque to the frontend).
  generationConfig   Json?
  active             Boolean          @default(true)
  trendingRank       Int?
  createdAt          DateTime         @default(now())

  generations Generation[]

  @@index([categoryId])
  @@index([trendingRank])
}

model CreditPackage {
  id       String    @id
  name     String
  /// Total credits issued, bonus included.
  credits  Int
  bonusCredits Int   @default(0)
  priceMnt Int
  /// Shown as "Most Popular".
  highlighted Boolean @default(false)
  active   Boolean   @default(true)
  sortOrder Int      @default(0)
  payments Payment[]
}

model Generation {
  id           String           @id @default(cuid())
  /** Null for guest generations until they sign in. */
  userId       String?
  user         User?            @relation(fields: [userId], references: [id])
  /** Anonymous session that owns a guest generation. */
  guestId      String?
  templateId   String
  template     Template         @relation(fields: [templateId], references: [id])
  status       GenerationStatus @default(QUEUED)
  inputKeys    String[]
  previewKey   String?
  outputKey    String?
  /// Task id returned by the generation provider (Seedance); never exposed to clients.
  providerTaskId String?
  /// Provider-hosted result URL. Served to clients only through our own proxy route.
  outputUrl    String?
  creditCost   Decimal          @default(0) @db.Decimal(10, 2)
  /// Resolution the user picked (480p / 720p for video; the render size for images).
  resolution   String           @default("480p")
  /// Set when the credits were handed back after a failure.
  refundedAt   DateTime?
  error        String?
  createdAt    DateTime         @default(now())
  completedAt  DateTime?

  @@index([userId, createdAt])
  @@index([guestId])
}

/// Photos uploaded for a generation. Served by an unguessable URL so the AI provider
/// can fetch them; swap for object storage (S3/R2) when volume grows.
model Upload {
  id          String   @id @default(uuid())
  /// "u:<userId>" or "g:<guestId>"
  ownerKey    String
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())

  @@index([ownerKey, createdAt])
  @@index([createdAt])
}

/// Media uploaded in the admin panel (template previews and source videos). Served by an
/// unguessable URL (/api/assets/<id>) so the AI provider can fetch source videos; swap for
/// object storage (S3/R2) when volume grows.
model Asset {
  id          String   @id @default(uuid())
  contentType String
  size        Int
  /// Length in seconds for videos.
  duration    Float?
  data        Bytes
  createdAt   DateTime @default(now())
}

/// Finished video copied from the provider (whose result URLs expire), so history and
/// downloads keep working. Kept apart from Generation so list queries never load the bytes;
/// swap for object storage (S3/R2) when volume grows.
model GenerationVideo {
  generationId String   @id
  contentType  String
  size         Int
  data         Bytes
  createdAt    DateTime @default(now())
}

model CreditLedger {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  /** Positive = credits added, negative = credits spent. */
  delta        Decimal      @db.Decimal(10, 2)
  reason       LedgerReason
  generationId String?
  paymentId    String?
  createdAt    DateTime     @default(now())

  @@index([userId, createdAt])
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  packageId   String
  package     CreditPackage @relation(fields: [packageId], references: [id])
  amountMnt   Int
  credits     Int
  status      PaymentStatus @default(PENDING)
  /** QPay invoice id (the object id payments are checked against). */
  providerRef String?       @unique
  /// QPay's reply to the invoice: QR text and image, short link and bank app links.
  invoice     Json?
  /// QPay's payment id once the payment came in, kept for reference and refunds.
  qpayPaymentId String?
  /// When QPay was last asked about this payment, to rate-limit manual checks.
  lastCheckAt DateTime?
  createdAt   DateTime      @default(now())
  paidAt      DateTime?

  @@index([userId])
}

/// Admin-editable numbers behind the automatic selling price. One row (id "default"); without it the
/// defaults in src/lib/pricing-settings.ts apply.
model PricingSetting {
  id              String   @id @default("default")
  /// Share of the provider cost added for failed or repeated requests we pay for (0.05 = 5%).
  retryBufferRate Decimal  @default(0.05) @db.Decimal(5, 4)
  /// Share of the selling price the payment gateway keeps (0.015 = 1.5%).
  gatewayFeeRate  Decimal  @default(0.015) @db.Decimal(5, 4)
  updatedAt       DateTime @updatedAt
}
